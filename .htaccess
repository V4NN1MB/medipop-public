# medipop.app: sito statico (solo HTML e CSS), nessuno script, nessun
# modulo, nessun cookie. Le intestazioni sotto lo dicono anche al browser.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Solo risorse di questo sito; nessuno script, nessun iframe, nessun modulo.
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Tutto il dominio .app e' gia' nella lista HSTS dei browser; l'intestazione
  # vale per gli altri client. Niente "preload": non serve per un .app.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Un solo indirizzo: https://medipop.app (www e http ci arrivano con un 301).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.medipop\.app$ [NC]
  RewriteRule ^ https://medipop.app%{REQUEST_URI} [R=301,L]
  RewriteCond %{SERVER_PORT} =80
  RewriteRule ^ https://medipop.app%{REQUEST_URI} [R=301,L]
</IfModule>

# I file di servizio del repository non si servono.
<FilesMatch "^(README\.md|LICENSE|\.git.*)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
